{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src/merge-i18n",
    "declaration": true,
    "skipLibCheck": true
  },
  "files": [
    "src/merge-i18n/merge-i18n.ts",
    "src/merge-i18n/utils.ts",
    "src/merge-i18n/xlf-merge.ts",
    "src/merge-i18n/xlf2-merge.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compileOnSave": false,
  "buildOnSave": false
}